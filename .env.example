# ===========================================
# BIthere v2 - Platform-level environment
# API key layanan user (Groq/OpenAI/Pinecone) TIDAK di sini.
# Disimpan per workspace di DB dengan enkripsi Fernet.
# ===========================================

# --- Security ---
MASTER_ENCRYPTION_KEY=

# --- Supabase (platform auth + app DB) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_SECRET=

# --- Redis ---
REDIS_URL=redis://redis:6379/0
REDIS_WORKSPACE_PREFIX=ws:

# --- Upload & Analytics ---
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=500
DUCKDB_DIR=./duckdb

# --- MinIO (optional) ---
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# --- Rate limit ---
RATE_LIMIT_MAX_CONCURRENT=5
RATE_LIMIT_BACKOFF_MAX=60

# --- Metabase (platform-level) ---
METABASE_URL=http://metabase:3000
METABASE_USERNAME=
METABASE_PASSWORD=

# --- Frontend (Vite) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- Test ---
TEST_MODE=live

# --- Embedding ---
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSION=768

# --- Registration & Workspace policy ---
ALLOW_SELF_REGISTER=false
ALLOW_WORKSPACE_CREATION=admin_only

# --- Bootstrap admin (dibuat otomatis saat backend pertama start) ---
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=